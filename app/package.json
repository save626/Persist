{
  "name": "persist-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "shared:build": "tsc -p ../shared/tsconfig.json",
    "predev": "npm run shared:build",
    "dev": "vite --host 0.0.0.0",
    "dev:mobile": "npm run shared:build && vite --mode mobile --host 0.0.0.0",
    "prebuild": "npm run shared:build",
    "build": "tsc -b && vite build --base=/app/",
    "build:mobile": "npm run shared:build && tsc -b && vite build --mode mobile --outDir dist-mobile",
    "preview": "vite preview --host 0.0.0.0 --base=/app/",
    "lint": "oxlint",
    "pretypecheck": "npm run shared:build",
    "typecheck": "tsc -b",
    "pretest": "npm run shared:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run shared:build",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "previsual:check": "npm run shared:build",
    "visual:check": "node scripts/visual-check.mjs",
    "android:check": "node scripts/android-usb.mjs --check",
    "android:sync": "node scripts/android-usb.mjs --sync",
    "android:usb": "node scripts/android-usb.mjs",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/network": "^8.0.1",
    "@persist/shared": "file:../shared",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
