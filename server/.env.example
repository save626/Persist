# Persist 服务端环境变量示例。
# 真实值只放在服务器 /etc/persist/server.env（权限 600），不要提交到仓库。
# 本文件仅用于说明字段，不含任何真实密钥。

# 监听地址：只监听回环，由 Nginx 反代 /api/*
HOST=127.0.0.1
PORT=3000

# DeepSeek 密钥；留空时 /api/chat 返回 503，前端自动回退到本地 Mock。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 单次模型调用超时与重试次数（只对可重试错误生效：429 / 5xx / 网络错误）
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=1

# 按 IP 的滑动窗口限流：窗口内最多 RATE_LIMIT_MAX 次 /api/chat
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=300000

# 步骤 13 服务端综合分析（/api/v1/analysis/*）。独立限流，不占用 AI 对话额度。
# 按 IP 的窗口内最多可生成次数：默认 6；超限返回 429 rate_limited
ANALYSIS_RATE_LIMIT_MAX=6
# 单次分析调用的超时与输出上限（毫秒 / tokens）；超时按规则降级处理，不报 5xx
ANALYSIS_TIMEOUT_MS=45000
ANALYSIS_MAX_TOKENS=2600

# 每日简报 job（进程内 60 s 调度，不需要额外的 systemd timer）。
# 默认关闭；开启后按「本地日期」每天只跑一次，失败最多重试 2 次。
# 注意：简报读取的是同步上来的 settings.payload_json.dailyBrief，
# 因此必须先开启跨设备同步并同步设置；下面两个变量只在完全没有 settings 时兜底。
DAILY_BRIEF_ENABLED=false
DAILY_BRIEF_AT=21:00

# 位于 Nginx 之后时设为 1，按 X-Forwarded-For 识别真实 IP
TRUST_PROXY=1
LOG_LEVEL=info
