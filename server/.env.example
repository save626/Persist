# Persist 服务端环境变量示例。
# 真实值只放在服务器 /etc/persist/server.env（权限 600），不要提交到仓库。
# 本文件仅用于说明字段，不含任何真实密钥。

# 监听地址：只监听回环，由 Nginx 反代 /api/*
HOST=127.0.0.1
PORT=3000

# Capacitor Android WebView 的本地 origin；多个来源用英文逗号分隔。
# 留空时默认允许 https://localhost；这不是鉴权，AI 接口仍需服务端门禁。
PERSIST_ALLOWED_ORIGINS=https://localhost

# DeepSeek 密钥；留空时 /api/chat 返回 503，前端自动回退到本地 Mock。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 单次模型调用超时与重试次数（只对可重试错误生效：429 / 5xx / 网络错误）
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=1

# 按 IP 的滑动窗口限流：窗口内最多 RATE_LIMIT_MAX 次 /api/chat
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=300000

# 步骤 13 服务端综合分析（/api/v1/analysis/*）。独立限流，不占用 AI 对话额度。
# 按 IP 的窗口内最多可生成次数：默认 6；超限返回 429 rate_limited
ANALYSIS_RATE_LIMIT_MAX=6
# 单次分析调用的超时与输出上限（毫秒 / tokens）；超时按规则降级处理，不报 5xx
ANALYSIS_TIMEOUT_MS=45000
ANALYSIS_MAX_TOKENS=2600

# 每日简报 job（进程内 60 s 调度，不需要额外的 systemd timer）。
# 默认关闭；开启后按「本地日期」每天只跑一次，失败最多重试 2 次。
# 注意：简报读取的是同步上来的 settings.payload_json.dailyBrief，
# 因此必须先开启跨设备同步并同步设置；下面两个变量只在完全没有 settings 时兜底。
DAILY_BRIEF_ENABLED=false
DAILY_BRIEF_AT=21:00

# 跨设备同步接口的独立限流（客户端 60 s 轮询一次，不能占用 AI 额度）
SYNC_RATE_LIMIT_MAX=240

# SQLite 单文件库；生产指向 /var/lib/persist/persist.sqlite（目录 750、属主 persist）
# 本地开发留空即用默认 data/persist.sqlite
DB_PATH=data/persist.sqlite
# 单条语句遇忙等锁的上限；同步写入很频繁，5 s 足够
DB_BUSY_TIMEOUT_MS=5000

# 步骤 14a 每日备份（systemd timer persist-backup.timer 在 03:00 调 backup-cli.js）
# 备份目录默认与库同级 backups/（生产即 /var/lib/persist/backups），需要单独放再写这一行
# DB_BACKUP_DIR=/var/lib/persist/backups
# 保留策略：近 7 天全留 + 近 4 周每周一份 + 近 3 月每月一份；最新一份永远保留
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=3
# 库所在分区使用率达到该百分比时 /api/health 的 storage.status 变成 warn
DISK_WARN_PERCENT=85

# 位于 Nginx 之后时设为 1，按 X-Forwarded-For 识别真实 IP
TRUST_PROXY=1
LOG_LEVEL=info
