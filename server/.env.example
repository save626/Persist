# Persist 服务端环境变量示例。
# 真实值只放在服务器 /etc/persist/server.env（权限 600），不要提交到仓库。
# 本文件仅用于说明字段，不含任何真实密钥。

# 监听地址：只监听回环，由 Nginx 反代 /api/*
HOST=127.0.0.1
PORT=3000

# Capacitor Android WebView 的本地 origin；多个来源用英文逗号分隔。
# 留空时默认允许 https://localhost。
# CORS 只约束浏览器，不是鉴权：AI 接口的调用者凭据由下面的 PERSIST_AI_GATE 负责。
PERSIST_ALLOWED_ORIGINS=https://localhost

# P0 AI 接口凭据门（/api/chat、/api/report）。
# enforce = 校验失败返回 401 ai_unauthorized（**默认值**，fail-closed）
# warn    = 校验但不拒绝，只把结果打进日志（用于确认新 APK 是否带对凭据）
# off     = 不校验，仅供本地开发/回滚，切勿用于公网部署
# 迁移期上线顺序：先 warn → 装新 APK → 看日志确认 → 再显式 enforce；
# 新部署什么都不配时即为 enforce，绝不会静默敞开付费接口。
# 本地开发若要旧行为，显式写 off。
PERSIST_AI_GATE=enforce
# 允许调用 AI 接口的凭据，格式 keyId:sha256hex，多条用英文逗号分隔。
# 只存哈希；生成方式见 docs/P0-AI接口服务端安全门设计方案.md §4.10。
# 配了 enforce 而这里为空时会拒绝一切 AI 请求（fail-closed，刻意选择）。
PERSIST_AI_KEYS=

# P0 Step 2 日配额：每个凭据每天最多多少次 AI 调用，0 = 关闭这一维。
# 与 PERSIST_AI_GATE 无关：即使把门设成 off，计数依然生效（归到 anonymous），
# 免得「关掉门」顺手把止损也关掉。超限返回 429 ai_quota_exceeded，次日 00:00（服务器本地时间）恢复。
# 计数口径是预占：失败请求不退还，所以上游长时间故障也会消耗额度。
PERSIST_AI_DAILY_LIMIT=100

# P0 Step 3 token 配额：每个凭据每天最多花多少 token（输入 + 输出），0 = 关闭这一维。
# 次数只约束频率，不约束成本：100 次里可以是 100 条短对话，也可以是几十份长报告。
# 口径是「进门判余 + 出门记账」，所以当天最后一次请求可以把总量顶过上限一截（最多一次请求的量）；
# 流被中途取消时上游不返回 usage，这部分**少算**，不会多算。
# 默认 200000 ≈ 正常一天用量的 4–10 倍余量。
PERSIST_AI_DAILY_TOKENS=200000

# P0-4 审计保留期：ai_calls 保留多少天，0 = 不清理（无限保留）。
# 注意这个 0 与上面两个配额的 0 语义相反：配额 0 是「关掉限制」，这里 0 是「关掉清理」。
# 清理是删数据，默认必须保守，所以「关」= 不删。每天 04:00 之后跑一次（错开 03:00 的库快照），
# 用 job_runs 的 (name, run_key) 去重，重启不会当天重复删；删除分批进行，避免长时间持有写锁。
# ai_usage（按天汇总）不受影响：那是几十行历史成本曲线，删了反而丢失信息。
PERSIST_AI_AUDIT_KEEP_DAYS=30

# 账号总数上限（POST /api/v1/devices 新注册）。默认 1：个人自用，换机走恢复码不占名额。
# 开放注册 + 设备令牌直连 AI 时，每个账号有独立日配额，多账号会把作者付费的账单倍增；
# 因此默认收紧为 1（2026-11-25 安全审查）。确需多账号时显式调大；0 = 不限制（不推荐公网）。
# 上限检查在写事务内完成，并发注册不会突破（TOCTOU 已消除）。
PERSIST_REGISTRATION_MAX_ACCOUNTS=1

# 数据操作审计保留天数（P5-2）：audit_log 里「建设备 / 吊销设备 / 删账号 / 建快照 /
# 恢复快照 / 导出」这些行的保留期。0 = 不清理（与 AI 审计同一套语义）。
# 与 PERSIST_AI_AUDIT_KEEP_DAYS 分开是为了能各自调：排查「数据怎么没的」往往需要更长的
# 窗口，而逐次核对过之后可以单独把 AI 侧缩短。默认同为 30 天。
PERSIST_AUDIT_KEEP_DAYS=30

# 同步留痕保留天数（P5-1）：墓碑行（客户端删除留下的 deleted_at 行）+ sync_ops 幂等记录。
# 0 = 不清理（与配额两个 0 相反）。默认 30，与 DATA_RETENTION.tombstoneDays 同源。
# 墓碑要先把删除传播给其他设备才有价值，所以除了时间还多一道判断：必须比「最久未联系
# 的活跃设备」更老才会删——否则 40 天没开机的设备回来后看不到删除，本地会留幽灵行。
PERSIST_SYNC_RETENTION_DAYS=30

# DeepSeek 密钥；留空时 /api/chat 返回 503，前端自动回退到本地 Mock。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名用官方在售名：deepseek-flash（默认，便宜快速）/ deepseek-v4-pro（强推理）。
# 旧名 deepseek-chat / deepseek-reasoner 已停用，不要再用。
DEEPSEEK_MODEL=deepseek-flash

# 单次模型调用超时与重试次数（只对可重试错误生效：429 / 5xx / 网络错误）
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=1

# 按 IP 的滑动窗口限流：窗口内最多 RATE_LIMIT_MAX 次 /api/chat
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=300000

# 步骤 13 服务端综合分析（/api/v1/analysis/*）。独立限流，不占用 AI 对话额度。
# 按 IP 的窗口内最多可生成次数：默认 6；超限返回 429 rate_limited
ANALYSIS_RATE_LIMIT_MAX=6
# 单次分析调用的超时与输出上限（毫秒 / tokens）；超时按规则降级处理，不报 5xx
ANALYSIS_TIMEOUT_MS=45000
ANALYSIS_MAX_TOKENS=2600

# 每日简报 job（进程内 60 s 调度，不需要额外的 systemd timer）。
# 默认关闭；开启后按「本地日期」每天只跑一次，失败最多重试 2 次。
# 注意：简报读取的是同步上来的 settings.payload_json.dailyBrief，
# 因此必须先开启跨设备同步并同步设置；下面两个变量只在完全没有 settings 时兜底。
DAILY_BRIEF_ENABLED=false
DAILY_BRIEF_AT=21:00

# 跨设备同步接口的独立限流（客户端 60 s 轮询一次，不能占用 AI 额度）
SYNC_RATE_LIMIT_MAX=240

# SQLite 单文件库；生产指向 /var/lib/persist/persist.sqlite（目录 750、属主 persist）
# 本地开发留空即用默认 data/persist.sqlite
DB_PATH=data/persist.sqlite
# 单条语句遇忙等锁的上限；同步写入很频繁，5 s 足够
DB_BUSY_TIMEOUT_MS=5000

# 步骤 14a 每日备份（systemd timer persist-backup.timer 在 03:00 调 backup-cli.js）
# 备份目录默认与库同级 backups/（生产即 /var/lib/persist/backups），需要单独放再写这一行
# DB_BACKUP_DIR=/var/lib/persist/backups
# 保留策略：近 7 天全留 + 近 4 周每周一份 + 近 3 月每月一份；最新一份永远保留
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=3
# 库所在分区使用率达到该百分比时 /api/health 的 storage.status 变成 warn
DISK_WARN_PERCENT=85

# 位于 Nginx 之后时按 X-Forwarded-For 识别真实 IP。默认值就是 loopback，
# 含义是「只信任本机反向代理写入的那一跳」，客户端自己伪造的前缀会被丢弃。
# 代理不在本机时改成它的网段（如 TRUST_PROXY=10.0.0.0/8）；
# 写成 1/true 表示无条件信任整条 XFF 链 —— 客户端可随意伪造来源，等于关掉 IP 限流。
# TRUST_PROXY=loopback
LOG_LEVEL=info
